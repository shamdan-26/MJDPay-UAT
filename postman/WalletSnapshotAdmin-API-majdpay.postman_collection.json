            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/wallet-snapshots/{{snapshotId}}",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "v1", "admin", "wallet-snapshots", "{{snapshotId}}" ]
            },
            "description": "Detail adds discrepancies and validationDetails on top of the list row shape. Header set is an exact match to the real captured curl."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('detail shape includes discrepancies and validationDetails', () => {",
                  "  pm.expect(b).to.have.property('discrepancies');",
                  "  pm.expect(b).to.have.property('validationDetails');",
                  "  pm.expect(Array.isArray(b.validationDetails)).to.be.true;",
                  "});",
                  "pm.test('validationDetails is ordered by occurredAt ascending', () => {",
                  "  const steps = b.validationDetails || [];",
                  "  for (let i = 1; i < steps.length; i++) {",
                  "    pm.expect(new Date(steps[i].occurredAt).getTime()).to.be.at.least(new Date(steps[i - 1].occurredAt).getTime());",
                  "  }",
                  "});",
                  "pm.test('every validationDetails entry shares this snapshot\\'s runId', () => {",
                  "  const steps = b.validationDetails || [];",
                  "  if (steps.length > 0) {",
                  "    const runId = steps[0].runId;",
                  "    steps.forEach((s) => pm.expect(s.runId).to.eql(runId));",
                  "  }",
                  "});",
                  "pm.test('reason equals the latest non-null event reason, or null if none', () => {",
                  "  const steps = (b.validationDetails || []).filter((s) => s.reason !== null && s.reason !== undefined);",
                  "  if (steps.length === 0) {",
                  "    pm.expect(b.reason).to.be.null;",
                  "  } else {",
                  "    const latest = steps.reduce((a, c) => new Date(c.occurredAt) > new Date(a.occurredAt) ? c : a);",
                  "    pm.expect(b.reason).to.eql(latest.reason);",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
